<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:gravity="center_horizontal">

    <!-- Handle Bar -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_handle_pill"
        android:layout_marginBottom="20dp" />

    <!-- Logout Icon Container -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_logout"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="#EF4444" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvLogoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Out of Your Account?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center" />

    <!-- Current Account User Pill -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tag_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvLogoutUserAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name (@username)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Description Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to log out? Your active session will be ended and you will need to sign in again to access tasks, client documents, and portal workflows."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cancel / Keep Session -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#475569"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp" />

        <!-- Confirm Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmLogout"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Yes, Log Out"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#EF4444"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
