<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ================================================================= -->
    <!-- VIEW 1: CLIENTS DIRECTORY (LIST OF CLIENTS)                       -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/layoutClientsListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Search Bar & Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:background="@color/card_background"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvAdminDocsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Client to View Documents"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvClientCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Clients (0)"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Search Filter Box -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearchClients"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search client by name or company..."
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchClients"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Loading indicator for clients -->
        <ProgressBar
            android:id="@+id/pbLoadingClientsList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:visibility="gone" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layoutEmptyClientsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvEmptyClientsMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No clients found in database"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryLoadClients"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="🔄 Refresh Clients"
                android:textColor="@color/primary"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- RecyclerView of clients -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshClientsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAdminClientsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:paddingBottom="100dp"
                android:clipToPadding="false"
                android:overScrollMode="always" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- ================================================================= -->
    <!-- VIEW 2: CLIENT DOCUMENT DETAILS SCREEN (OPENED ON CLIENT CLICK)   -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/layoutClientDocsDetailView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Navigation Bar for Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:background="@color/card_background"
            android:elevation="1dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToClientsList"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="← All Clients"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingHorizontal="6dp" />

            <TextView
                android:id="@+id/tvDetailTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Client Documents"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbDetailDocsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshClientDetailDocs"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollClientDetailDocs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="100dp">

                    <!-- Selected Client Header Profile Card (Minimal) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_circle_avatar"
                                android:backgroundTint="#EFF6FF">

                                <TextView
                                    android:id="@+id/tvDetailClientInitial"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="K"
                                    android:textColor="@color/primary"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:id="@+id/tvDetailClientName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="KP Pvt Ltd"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_circle_avatar"
                                        android:backgroundTint="#FEF3C7"
                                        android:paddingHorizontal="7dp"
                                        android:paddingVertical="2dp"
                                        android:text="Client"
                                        android:textColor="#D97706"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvDetailClientContact"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:text="Contact: Kashish patel"
                                    android:textSize="12sp"
                                    android:textColor="#475569" />

                                <TextView
                                    android:id="@+id/tvDetailClientInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="kpp@gmail.com • 9876789098"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 1: IDENTITY & KYC PROOFS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪪 Identity &amp; KYC"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- Card 1: Aadhar Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#EFF6FF"
                                    android:gravity="center"
                                    android:text="🪪"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Aadhar Card"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:id="@+id/tvAdminAadharMeta"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:text="KYC Verification Document"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAdminAadharStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Not Uploaded"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#D97706"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#FEF3C7" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutAdminAadharActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp"
                                android:weightSum="2"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminViewAadhar"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="👁 View"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary"
                                    app:strokeColor="@color/primary"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDownloadAadhar"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="⬇ Save"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#059669"
                                    app:strokeColor="#059669"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: PAN Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#EFF6FF"
                                    android:gravity="center"
                                    android:text="🪪"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="PAN Card"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:id="@+id/tvAdminPanMeta"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:text="KYC Verification Document"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAdminPanStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Not Uploaded"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#D97706"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#FEF3C7" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutAdminPanActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp"
                                android:weightSum="2"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminViewPan"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="👁 View"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary"
                                    app:strokeColor="@color/primary"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDownloadPan"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="⬇ Save"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#059669"
                                    app:strokeColor="#059669"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 2: FINANCIAL STATEMENTS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Financial Statements"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- Balance Sheet Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#EFF6FF"
                                    android:gravity="center"
                                    android:text="📊"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Balance Sheet"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:id="@+id/tvAdminBalanceSheetMeta"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:text="Annual Statement"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAdminBalanceSheetStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Pending"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#F1F5F9" />
                            </LinearLayout>

                            <!-- Actions Row (shown if uploaded) -->
                            <LinearLayout
                                android:id="@+id/layoutAdminBalanceSheetActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp"
                                android:weightSum="3"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminViewBalanceSheet"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="👁 View"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary"
                                    app:strokeColor="@color/primary"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDownloadBalanceSheet"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="2dp"
                                    android:text="⬇ Save"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#059669"
                                    app:strokeColor="#059669"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDeleteBalanceSheet"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="🗑 Delete"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#DC2626"
                                    app:strokeColor="#DC2626"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <!-- Upload / Replace Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAdminUploadBalanceSheet"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_marginTop="8dp"
                                android:text="📤 Upload PDF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:backgroundTint="@color/primary"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Profit and Loss Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider"
                        app:cardBackgroundColor="@color/card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#EFF6FF"
                                    android:gravity="center"
                                    android:text="📈"
                                    android:textSize="18sp" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Profit &amp; Loss Statement"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/text_primary" />

                                    <TextView
                                        android:id="@+id/tvAdminProfitLossMeta"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:text="Performance Statement"
                                        android:textSize="11sp"
                                        android:textColor="@color/text_secondary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvAdminProfitLossStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:text="Pending"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B"
                                    android:background="@drawable/bg_circle_avatar"
                                    android:backgroundTint="#F1F5F9" />
                            </LinearLayout>

                            <!-- Actions Row (shown if uploaded) -->
                            <LinearLayout
                                android:id="@+id/layoutAdminProfitLossActions"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp"
                                android:weightSum="3"
                                android:visibility="gone">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminViewProfitLoss"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:text="👁 View"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary"
                                    app:strokeColor="@color/primary"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDownloadProfitLoss"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="2dp"
                                    android:text="⬇ Save"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#059669"
                                    app:strokeColor="#059669"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAdminDeleteProfitLoss"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="🗑 Delete"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textAllCaps="false"
                                    android:textColor="#DC2626"
                                    app:strokeColor="#DC2626"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <!-- Upload / Replace Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAdminUploadProfitLoss"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_marginTop="8dp"
                                android:text="📤 Upload PDF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:backgroundTint="@color/primary"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SECTION 3: OTHER CLIENT DOCUMENTS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📁 Additional Files"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdminOpenUploadOtherPopup"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="➕ Upload"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/primary"
                            app:cornerRadius="8dp" />

                    </LinearLayout>

                    <!-- Container for dynamically added other documents -->
                    <LinearLayout
                        android:id="@+id/layoutAdminOtherDocsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvAdminNoOtherDocs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="#F8FAFC"
                        android:padding="16dp"
                        android:text="No additional files uploaded yet."
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</FrameLayout>
